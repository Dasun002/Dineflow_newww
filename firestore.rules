rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'manager'];
    }

    // Staff / manager role documents are created by hand in the Firebase console only.
    // Customers can create their own profile on registration, but cannot elevate their role to staff.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn()
        && request.auth.uid == uid
        && !(request.resource.data.role in ['staff', 'manager']);
      allow update: if signedIn()
        && request.auth.uid == uid
        && !(request.resource.data.role in ['staff', 'manager']);

      // Customer dining preferences: each customer can manage only their own preferences
      match /preferences/{prefId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Restaurant profile + floor tables: everyone signed in can read, only staff can change.
    match /restaurants/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /tables/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // Menu items: signed-in customers can browse; only staff/manager accounts can create, update, or delete/archive.
    match /menuItems/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // Reservations: diners create / modify / cancel their own; staff manage all.
    match /reservations/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'confirmed';
      allow update: if isStaff()
        || (signedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // Virtual queue: diners join, may mark "arrived" or leave; staff do everything else.
    match /queue/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'waiting';
      allow update: if isStaff()
        || (signedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'arrived'])
            && (request.resource.data.status == resource.data.status || request.resource.data.status == 'left'));
      allow delete: if false;
    }

    // Ticket-number counter (incremented inside a transaction when a diner joins).
    match /meta/{id} {
      allow read: if signedIn();
      allow write: if isStaff()
        || (signedIn() && resource != null && request.resource.data.n == resource.data.n + 1);
    }
  }
}
